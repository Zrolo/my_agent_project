# NOI Agent 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# Kimi/Moonshot API Key（必填）
# 用于：主答疑链路 + 意图分类器
MOONSHOT_API_KEY=your_moonshot_api_key_here

# 可选：按顺序尝试可用模型，前一个没有权限或不存在时自动回退到下一个
# NOI_CHAT_MODELS=kimi-k2.5
# NOI_REVIEW_MODELS=kimi-k2.5
# NOI_CLASSIFIER_MODELS=kimi-k2.5

# 可选：OpenAI 兼容格式
# OPENAI_API_KEY=your_key_here

# 教师密钥（用于重置配额，必填）
NOI_TEACHER_SECRET=your_teacher_secret_here
