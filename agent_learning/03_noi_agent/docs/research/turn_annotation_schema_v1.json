{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPMissingBridgeTurnAnnotationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turn",
    "context",
    "coach_label",
    "system_prediction",
    "system_response",
    "response_evaluation",
    "next_turn_learning_evidence",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "turn_annotation_v1"
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "session_id_hash",
        "student_id_hash",
        "problem_id",
        "turn_index",
        "timestamp_utc",
        "baseline_group"
      ],
      "properties": {
        "turn_id": { "type": "string", "minLength": 1 },
        "session_id_hash": { "type": "string", "minLength": 1 },
        "student_id_hash": { "type": "string", "minLength": 1 },
        "problem_id": { "type": "string" },
        "turn_index": { "type": "integer", "minimum": 0 },
        "timestamp_utc": { "type": "string" },
        "baseline_group": { "$ref": "#/$defs/baseline_group" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_ref",
        "student_message",
        "recent_dialogue",
        "student_code_excerpt"
      ],
      "properties": {
        "problem_ref": { "type": "string" },
        "student_message": { "type": "string", "minLength": 1 },
        "recent_dialogue": {
          "type": "array",
          "items": { "$ref": "#/$defs/dialogue_message" }
        },
        "student_code_excerpt": {
          "type": ["string", "null"]
        }
      }
    },
    "coach_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_solving_state",
        "missing_bridge",
        "help_seeking_type",
        "allowed_help_level_gold",
        "forbidden_content",
        "confidence",
        "annotator_id",
        "notes"
      ],
      "properties": {
        "problem_solving_state": { "$ref": "#/$defs/problem_solving_state" },
        "missing_bridge": { "$ref": "#/$defs/missing_bridge" },
        "help_seeking_type": { "$ref": "#/$defs/help_seeking_type" },
        "allowed_help_level_gold": { "$ref": "#/$defs/help_level" },
        "forbidden_content": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "annotator_id": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "system_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge_name",
        "problem_solving_state",
        "missing_bridge",
        "help_seeking_type",
        "allowed_help_level",
        "help_form",
        "forbidden_content",
        "leakage_risk",
        "confidence"
      ],
      "properties": {
        "judge_name": { "type": "string" },
        "problem_solving_state": { "$ref": "#/$defs/problem_solving_state_or_unknown" },
        "missing_bridge": { "$ref": "#/$defs/missing_bridge" },
        "help_seeking_type": { "$ref": "#/$defs/help_seeking_type" },
        "allowed_help_level": { "$ref": "#/$defs/help_level" },
        "help_form": { "$ref": "#/$defs/help_form" },
        "forbidden_content": {
          "type": "array",
          "items": { "type": "string" }
        },
        "leakage_risk": { "$ref": "#/$defs/leakage_risk" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "system_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_provider",
        "model_name",
        "tutor_action",
        "response_text",
        "self_reported_level"
      ],
      "properties": {
        "model_provider": { "type": "string" },
        "model_name": { "type": "string" },
        "tutor_action": { "type": "string" },
        "response_text": { "type": "string" },
        "self_reported_level": { "$ref": "#/$defs/help_level_or_l4" }
      }
    },
    "response_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality_scores",
        "quality_total",
        "leakage_label",
        "evaluator_id",
        "notes"
      ],
      "properties": {
        "quality_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bridge_identification",
            "groundedness",
            "scaffold_appropriateness",
            "bridge_leakage_control",
            "next_step_clarity",
            "single_focus_coherence"
          ],
          "properties": {
            "bridge_identification": { "$ref": "#/$defs/score_0_2" },
            "groundedness": { "$ref": "#/$defs/score_0_2" },
            "scaffold_appropriateness": { "$ref": "#/$defs/score_0_2" },
            "bridge_leakage_control": { "$ref": "#/$defs/score_0_2" },
            "next_step_clarity": { "$ref": "#/$defs/score_0_2" },
            "single_focus_coherence": { "$ref": "#/$defs/score_0_2" }
          }
        },
        "quality_total": { "type": "integer", "minimum": 0, "maximum": 12 },
        "leakage_label": { "$ref": "#/$defs/leakage_label" },
        "evaluator_id": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "next_turn_learning_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "student_uptake",
        "self_explanation",
        "transfer_signal",
        "error_correction",
        "independence",
        "notes"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "student_uptake": { "$ref": "#/$defs/nullable_score_0_2" },
        "self_explanation": { "$ref": "#/$defs/nullable_score_0_2" },
        "transfer_signal": { "$ref": "#/$defs/nullable_score_0_2" },
        "error_correction": { "$ref": "#/$defs/nullable_score_0_2" },
        "independence": { "$ref": "#/$defs/nullable_score_0_2" },
        "notes": { "type": "string" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_personal_data_removed",
        "hash_salt_version",
        "export_scope"
      ],
      "properties": {
        "raw_personal_data_removed": { "type": "boolean" },
        "hash_salt_version": { "type": "string" },
        "export_scope": {
          "enum": ["internal_eval", "paper_aggregate", "public_release_candidate"]
        }
      }
    }
  },
  "$defs": {
    "baseline_group": {
      "enum": [
        "generic_llm_tutor",
        "socratic_prompt_tutor",
        "current_system",
        "pedagogical_judge_v2",
        "bridge_judge",
        "bridge_judge_with_leakage_judge",
        "human_coach"
      ]
    },
    "dialogue_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["user", "assistant", "system"] },
        "content": { "type": "string" }
      }
    },
    "problem_solving_state": {
      "enum": [
        "text_comprehension_blocked",
        "problem_representation_unclear",
        "strategy_generation_blocked",
        "strategy_misconception",
        "strategy_application_gap",
        "implementation_execution_gap",
        "debugging_verification_gap",
        "reflection_transfer_gap"
      ]
    },
    "problem_solving_state_or_unknown": {
      "enum": [
        "text_comprehension_blocked",
        "problem_representation_unclear",
        "strategy_generation_blocked",
        "strategy_misconception",
        "strategy_application_gap",
        "implementation_execution_gap",
        "debugging_verification_gap",
        "reflection_transfer_gap",
        "unknown"
      ]
    },
    "bridge_family": {
      "enum": [
        "representation_bridge",
        "transition_bridge",
        "predicate_bridge",
        "modeling_bridge",
        "selection_bridge",
        "aggregation_bridge",
        "ordering_bridge",
        "mapping_bridge",
        "boundary_bridge",
        "complexity_bridge",
        "unknown_bridge"
      ]
    },
    "missing_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "subtype",
        "description",
        "evidence",
        "known_focus",
        "needs_new_focus"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/bridge_family" },
        "subtype": { "type": "string" },
        "description": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "known_focus": { "type": "string" },
        "needs_new_focus": { "type": "boolean" }
      }
    },
    "help_seeking_type": {
      "enum": ["instrumental_help", "executive_help", "help_avoidance", "unclear"]
    },
    "help_level": {
      "enum": ["L1", "L2", "L3"]
    },
    "help_level_or_l4": {
      "enum": ["L1", "L2", "L3", "L4"]
    },
    "help_form": {
      "enum": [
        "question",
        "hint",
        "micro_example",
        "counterexample",
        "diagram",
        "checklist",
        "local_pseudocode",
        "code_diagnosis",
        "summary",
        "mixed",
        "unknown"
      ]
    },
    "leakage_risk": {
      "enum": ["low", "medium", "high", "unknown"]
    },
    "leakage_label": {
      "enum": [
        "no_leakage",
        "minor_bridge_leakage",
        "major_bridge_leakage",
        "answer_leakage"
      ]
    },
    "score_0_2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "nullable_score_0_2": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 2
    }
  }
}
