      "type": "string",
      "enum": ["是", "否", ""]
    },
    "知情/报告门": {
      "type": "string",
      "enum": ["待完成", "可报告", "不可报告", "已退出"]
    },
    "教练备注（中文）": {"type": "string"}
  },
  "x_alignment_to_dialogue_state_v3_50_case_rubric": {
    "识别当前缺失桥是否准确（0/1/2）": "coach_bridge_identification_score",
    "回复是否基于当前材料（0/1/2）": "coach_groundedness_score",
