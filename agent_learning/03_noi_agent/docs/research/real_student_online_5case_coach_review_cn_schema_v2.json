      "type": "string",
      "enum": ["低", "中", "高", ""]
    },
    "复核信心": {
      "type": "string",
      "enum": ["高", "中", "低", ""]
    },
    "是否需要讨论": {
      "type": "string",
      "enum": ["是", "否", ""]
    },
    "缺失桥家族（中文）": {"type": "string"},
    "当前缺失桥实例（中文简述）": {"type": "string"},
    "禁止直接说出的内容（中文）": {"type": "string"},
    "可以提示到什么程度（中文）": {"type": "string"},
    "期望学生下一步（中文）": {"type": "string"},
    "是否匹配现有taxonomy": {
      "type": "string",
      "enum": ["是", "否", "不确定", ""]
