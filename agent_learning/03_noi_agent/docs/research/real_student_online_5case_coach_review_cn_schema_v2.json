      "type": "string",
      "enum": ["有进展", "部分进展", "无进展", "不清楚", "不可用", ""]
    },
    "是否同意AI预标注": {
      "type": "string",
      "enum": ["同意", "部分同意", "不同意", "不适用", ""]
    },
