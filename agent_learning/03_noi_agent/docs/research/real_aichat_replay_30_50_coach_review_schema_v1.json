{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real_aichat_replay_30_50_coach_review_schema_v1.json",
  "title": "Real-AIChat-Replay-30/50 Coach Review v1",
  "description": "Blind coach-review schema for offline replay responses. Observed current AIChat responses may be included only as observed references and are not counted as offline harness conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replay_case_id",
    "anonymized_response_id",
    "condition_hidden_from_reviewer",
    "condition_name_private_or_redacted",
    "response_role",
    "harness_name_private_or_redacted",
    "bridge_leakage_severity",
    "answer_or_code_leakage",
    "helpfulness",
    "learner_burden",
    "scaffold_quality",
    "student_ready",
    "safe_ready",
    "context_sufficiency_for_judgment",
    "coach_confidence",
    "reviewer_id",
    "review_date",
    "notes_no_raw_text"
  ],
  "properties": {
    "replay_case_id": {"type": "string", "minLength": 1},
    "anonymized_response_id": {"type": "string", "minLength": 1},
    "condition_hidden_from_reviewer": {"type": "string", "enum": ["yes", "no"]},
    "condition_name_private_or_redacted": {"type": "string"},
    "response_role": {"type": "string", "enum": ["offline_harness_response", "observed_reference"]},
    "harness_name_private_or_redacted": {"type": "string"},
    "bridge_leakage_severity": {"type": "string", "enum": ["none", "minor", "major", "critical", "unclear"]},
    "answer_or_code_leakage": {"type": "string", "enum": ["none", "minor", "major", "critical", "unclear"]},
    "helpfulness": {"type": "string", "enum": ["low", "medium", "high", "unclear"]},
    "learner_burden": {"type": "string", "enum": ["low", "medium", "high", "unclear"]},
    "scaffold_quality": {"type": "string", "enum": ["low", "medium", "high", "unclear"]},
    "student_ready": {"type": "string", "enum": ["yes", "no", "unclear"]},
    "safe_ready": {"type": "string", "enum": ["yes", "no", "unclear"]},
    "context_sufficiency_for_judgment": {"type": "string", "enum": ["sufficient", "partial", "insufficient", "unclear"]},
    "coach_confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "reviewer_id": {"type": "string"},
    "review_date": {"type": "string"},
    "notes_no_raw_text": {"type": "string"}
  }
}
