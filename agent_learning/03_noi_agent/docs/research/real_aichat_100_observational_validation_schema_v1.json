{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real_aichat_100_observational_validation_schema_v1.json",
  "title": "Real-AIChat-100 Observational Ecological-Validity Validation v1",
  "description": "Light annotation schema for 80-100 real AIChat target turns from our own system. This is observational ecological-validity validation only, not a condition-comparison experiment, not a learning-outcome study, and not a dialogue-state v3 main-result update.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "real_aichat_case_id",
    "source_candidate_turn_id",
    "student_id_hash_private_or_redacted",
    "problem_id_hash_private_or_redacted",
    "session_id_hash_private_or_redacted",
    "cp_tutoring_relevance",
    "substantial_turn",
    "context_sufficiency_light",
    "rough_bridge_family",
    "surface_anchor",
    "help_seeking_type",
    "missing_bridge_identifiable",
    "observed_current_aichat_response_available",
    "observed_current_aichat_response_role",
    "possible_bridge_leakage_concern",
    "candidate_for_replay",
    "candidate_for_trajectory_subset",
    "privacy_review_status",
    "consent_reporting_gate",
    "public_reporting_allowed",
    "selection_reason",
    "exclusion_reason",
    "annotator_id",
    "annotation_date",
    "notes_no_raw_text"
  ],
  "properties": {
    "real_aichat_case_id": {"type": "string", "minLength": 1},
    "source_candidate_turn_id": {"type": "string"},
    "student_id_hash_private_or_redacted": {"type": "string"},
    "problem_id_hash_private_or_redacted": {"type": "string"},
    "session_id_hash_private_or_redacted": {"type": "string"},
    "cp_tutoring_relevance": {"type": "string", "enum": ["yes", "no", "unclear"]},
    "substantial_turn": {"type": "string", "enum": ["yes", "no"]},
    "context_sufficiency_light": {"type": "string", "enum": ["sufficient", "partial", "insufficient", "unclear"]},
    "rough_bridge_family": {
      "type": "string",
      "enum": [
        "state_representation_bridge",
        "transition_recurrence_bridge",
        "predicate_check_bridge",
        "boundary_order_bridge",
        "modeling_bridge",
        "aggregation_contribution_bridge",
        "data_structure_bridge",
        "correctness_bridge",
        "implementation_bridge",
        "debugging_bridge",
        "policy_bridge",
        "other",
        "unclear"
      ]
    },
    "surface_anchor": {"type": "string"},
    "help_seeking_type": {
      "type": "string",
      "enum": [
        "conceptual_hint",
        "debugging",
        "implementation",
        "clarification",
        "direct_answer_request",
        "code_request",
        "other"
      ]
    },
    "missing_bridge_identifiable": {"type": "string", "enum": ["yes", "no", "unclear"]},
    "observed_current_aichat_response_available": {"type": "string", "enum": ["yes", "no"]},
    "observed_current_aichat_response_role": {"type": "string", "enum": ["observed_only_not_condition"]},
    "possible_bridge_leakage_concern": {"type": "string", "enum": ["yes", "no", "unclear", "not_assessed"]},
    "candidate_for_replay": {"type": "string", "enum": ["yes", "no"]},
    "candidate_for_trajectory_subset": {"type": "string", "enum": ["yes", "no"]},
    "privacy_review_status": {"type": "string", "enum": ["pending", "passed", "needs_redaction", "failed"]},
    "consent_reporting_gate": {"type": "string", "enum": ["pending", "eligible", "not_eligible", "consented", "unknown"]},
    "public_reporting_allowed": {"type": "string", "enum": ["yes", "no"]},
    "selection_reason": {"type": "string"},
    "exclusion_reason": {"type": "string"},
    "annotator_id": {"type": "string"},
    "annotation_date": {"type": "string"},
    "notes_no_raw_text": {"type": "string"}
  }
}
