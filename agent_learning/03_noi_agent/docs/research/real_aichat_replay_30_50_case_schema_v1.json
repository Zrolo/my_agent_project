{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real_aichat_replay_30_50_case_schema_v1.json",
  "title": "Real-AIChat-Replay-30/50 Case Packet v1",
  "description": "Case packet schema for real-log-grounded offline counterfactual replay. It does not store raw student text, complete code, complete AIChat replies, identity fields, hash salt, or reversible mappings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replay_case_id",
    "source_real_aichat_case_id",
    "replay_subset",
    "problem_summary",
    "constraints_io_summary",
    "recent_dialogue_summary",
    "current_student_state_summary",
    "missing_bridge_candidate",
    "forbidden_bridge_content",
    "acceptable_hint_boundary",
    "expected_next_student_action",
    "context_sufficiency",
    "privacy_review_status",
    "consent_reporting_gate",
    "public_reporting_allowed",
    "selection_reason",
    "exclusion_reason",
    "notes_no_raw_text"
  ],
  "properties": {
    "replay_case_id": {"type": "string", "minLength": 1},
    "source_real_aichat_case_id": {"type": "string"},
    "replay_subset": {"type": "string", "enum": ["replay30", "replay50_candidate", "trajectory_candidate"]},
    "problem_summary": {"type": "string"},
    "constraints_io_summary": {"type": "string"},
    "recent_dialogue_summary": {"type": "string"},
    "current_student_state_summary": {"type": "string"},
    "missing_bridge_candidate": {"type": "string"},
    "forbidden_bridge_content": {"type": "string"},
    "acceptable_hint_boundary": {"type": "string"},
    "expected_next_student_action": {"type": "string"},
    "context_sufficiency": {"type": "string", "enum": ["sufficient", "partial", "insufficient", "unclear"]},
    "privacy_review_status": {"type": "string", "enum": ["pending", "passed", "needs_redaction", "failed"]},
    "consent_reporting_gate": {"type": "string", "enum": ["pending", "eligible", "not_eligible", "consented", "unknown"]},
    "public_reporting_allowed": {"type": "string", "enum": ["yes", "no"]},
    "selection_reason": {"type": "string"},
    "exclusion_reason": {"type": "string"},
    "notes_no_raw_text": {"type": "string"}
  }
}
